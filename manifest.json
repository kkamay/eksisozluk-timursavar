{
  "manifest_version": 3,
  "name": "Ekşi Timursavar",
  "version": "1.0.0",
  "description": "Sponsorlu entry'lerdeki turkinform linkini, başlıkta 'timursavar' diye paylaşılan linkle değiştirir.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://eksisozluk.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Ekşi Timursavar"
  }
}